{
  "title": "Onboarding platform",
  "uid": "onboarding",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "temporal",
    "onboarding"
  ],
  "panels": [
    {
      "type": "row",
      "title": "Business outcomes (selected time range)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Onboardings completed",
      "description": "Employees activated: onboarding ran to completion. Note: Prometheus doesn't count the first event of a brand-new series, so on a quiet local stack the first occurrence may be missing.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(onboarding_events_total{event=\"EMPLOYEE_ACTIVATED\"}[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Onboardings rolled back",
      "description": "Cancelled or failed onboardings whose saga ran (HR record archived as the last compensation). Note: Prometheus doesn't count the first event of a brand-new series, so on a quiet local stack the first occurrence may be missing.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(onboarding_events_total{event=\"HR_RECORD_ARCHIVED\",workflow_type=\"onboardingWorkflow\"}[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Escalated to HR",
      "description": "Unsigned contracts, failed provisioning, or compensations that need a human. Note: Prometheus doesn't count the first event of a brand-new series, so on a quiet local stack the first occurrence may be missing.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
