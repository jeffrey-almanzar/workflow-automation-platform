      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(vendor_replayed_responses_total[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Business events / min",
      "description": "Every audit event recorded by activities.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
