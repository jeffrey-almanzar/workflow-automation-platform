      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(onboarding_events_total{event=\"ESCALATED_TO_HR\"}[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Duplicates prevented",
      "description": "Vendor calls answered from a stored idempotent response instead of being performed twice. Note: Prometheus doesn't count the first event of a brand-new series, so on a quiet local stack the first occurrence may be missing.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
